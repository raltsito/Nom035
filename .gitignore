# =============================================================================
# Intra NOM-035 — .gitignore
# =============================================================================

# Notas internas de deploy y credenciales — no subir al repo
cambiodominio.md
DEPLOY_NOTES.md
credenciales_produccion.html

# CONFIDENCIAL — Documentos con datos de clientes NUNCA deben subirse
*.pdf
*.PDF
INFORME*
informe*
diagnostico*
DIAGNOSTICO*
LEAR_*
# Excepción: assets de marca del informe (no son datos de cliente)
!backend/documents/static/**

# CONFIDENCIAL — Dumps y extractos de la BD de producción
*.dump
dump_produccion*
resultados_informe.txt
schema_tablas.txt
consultas_informe.sql

# Notas y scripts locales de trabajo (no son parte del sistema)
plan_informe_diagnostico.md
planinformes.md
generar_informe.py

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.env
secrets.json
local_settings.py

# =============================================================================
# Python / Django
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Entornos virtuales
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_collected/
static_root/

# Migraciones NO se ignoran — deben versionarse
# (no agregar */migrations/ aqui)

# Celery
celerybeat-schedule
celerybeat.pid

# WeasyPrint / PDFs generados en runtime
generated_pdfs/
tmp_pdfs/

# =============================================================================
# Node / React
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build de React
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/

# Cache de herramientas frontend
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# =============================================================================
# Docker
# =============================================================================
# Volumenes de datos locales — no versionar datos de BD
postgres_data/
redis_data/
docker_volumes/

# =============================================================================
# IDEs y editores
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# =============================================================================
# Sistema operativo
# =============================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# =============================================================================
# Archivos de cobertura y testing
# =============================================================================
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# =============================================================================
# Logs y temporales
# =============================================================================
*.log
*.tmp
*.temp
*.bak
*.backup
*.orig
logs/
log/

# BD de pruebas locales (settings.testing) y referencias de fidelidad de trabajo
backend/test_local.sqlite3
_refs_fidelidad/
