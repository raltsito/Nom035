# =============================================================================
# Intra NOM-035 — Variables de entorno
# Copiar este archivo como .env y rellenar los valores reales.
# NUNCA subir el .env al repositorio.
# =============================================================================

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
DJANGO_SETTINGS_MODULE=intra_nom035.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL en Docker)
DB_NAME=intra_nom035
DB_USER=intra
DB_PASSWORD=cambiar-por-password-seguro
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://intra:cambiar-por-password-seguro@localhost:5432/intra_nom035

# Redis (en Docker)
REDIS_URL=redis://localhost:6379/0

# CORS — origenes permitidos en desarrollo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (para emails, redirecciones)
FRONTEND_URL=http://localhost:5173

# Email (configurar en produccion)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Intra NOM-035 <noreply@intra.com>
